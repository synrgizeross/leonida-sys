{
  "name": "gta-vi-installer",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "go": "electron .",
    "build": "node build.js",
    "package:mac": "npx electron-packager ./build \"GTA VI\" --out=release --arch=x64 --platform=darwin --overwrite --prune=true --icon=gta6.icns --asar",
    "package:win": "npx electron-packager ./build \"GTA VI\" --out=release --arch=x64 --platform=win32 --overwrite --prune=true --icon=logo.ico --asar"
  },
  "keywords": [
    "GTA VI"
  ],
  "author": "Rockstar Games",
  "devDependencies": {
    "electron": "^35.2.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.25.10"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "electron-packager": "^17.1.2",
    "electron-tabs": "^1.0.4",
    "node-native-zip": "^1.1.0",
    "node-stream-zip": "^1.15.0"
  }
}